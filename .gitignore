# ====================================================================
# AGROVYN - Git Ignore Rules
# ====================================================================

# --------------------------------------------------------------------
# 1. Environment & Secret Credentials (CRITICAL - NEVER COMMIT)
# --------------------------------------------------------------------
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.backup

# --------------------------------------------------------------------
# 2. Next.js & Frontend Node Dependencies
# --------------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --------------------------------------------------------------------
# 3. Python & Machine Learning Artifacts
# --------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/

# Large ML model files (exceeds GitHub's 100MB file limit)
*.pkl
*.h5
*.joblib
*.pt
*.pth
*.onnx
backend/models/*.pkl

# Runtime sensor cache generated by FastAPI backend
backend/app/latest_sensor_cache.json

# --------------------------------------------------------------------
# 4. Operating System & Editor Files
# --------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-workspace
*.sublime-project

# --------------------------------------------------------------------
# 5. Arduino & Embedded Firmware Build Cache
# --------------------------------------------------------------------
*.elf
*.bin
*.hex
*.o
*.d
.arduino/
.arduinoIDE/
build/

