# AGROVYN Smart Adaptive Greenhouse Environment Configuration
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend Python FastAPI / Database / ML secrets
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-service-key
DATABASE_URL=postgresql://postgres:password@db.your-supabase-project.supabase.co:5432/postgres
API_SECRET=agrovyn_secret_token_12345
DEVICE_API_KEY=esp8266_agrovyn_device_key
MODEL_PATH=backend/models/greenhouse_model.pkl

# Optional Gemini supervisor (paste into .env.local at the project root, then restart FastAPI)
# GEMINI_API_KEY=your-google-ai-studio-key
# GOOGLE_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash-lite
